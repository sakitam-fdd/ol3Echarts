{
  "name": "ol-echarts",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "pnpm@10.34.0",
  "scripts": {
    "dev": "turbo run dev --filter='./packages/*'",
    "build": "turbo run build --filter='./packages/*'",
    "build:minify": "turbo run build:minify --filter='./packages/*'",
    "docs": "pnpm run docs:dev",
    "docs:dev": "pnpm --filter ol-echarts-docs run start",
    "docs:build": "pnpm --filter ol-echarts-docs run build",
    "version": "changeset version",
    "changeset": "changeset",
    "clear": "turbo run clear --filter='./packages/*'",
    "release": "pnpm build && pnpm build:minify && pnpm test-only && pnpm changeset publish",
    "lint": "turbo run lint --filter='./packages/*'",
    "prettier": "prettier --parser=typescript --write **/*.{js,ts,md}",
    "test": "turbo run test --filter='./packages/*'",
    "test-only": "turbo run test-only --filter='./packages/*'",
    "coverage": "turbo run coverage --filter='./packages/*'",
    "check": "pnpm lint && pnpm test-only && pnpm build && pnpm docs:build"
  },
  "resolutions": {
    "typedoc": "^0.28.0",
    "typedoc-plugin-markdown": "^4.12.0",
    "webpackbar": "^7.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "typedoc": "^0.28.0",
      "typedoc-plugin-markdown": "^4.12.0",
      "webpackbar": "^7.0.0",
      "@docusaurus/core": "3.10.1",
      "@docusaurus/types": "3.10.1",
      "@docusaurus/theme-common": "3.10.1",
      "@docusaurus/plugin-content-docs": "3.10.1",
      "@docusaurus/mdx-loader": "3.10.1",
      "@docusaurus/utils": "3.10.1",
      "@docusaurus/utils-common": "3.10.1"
    }
  },
  "devDependencies": {
    "@aurorafe/eslint-config-base": "^1.1.0",
    "@aurorafe/eslint-config-ts": "^1.1.0",
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.9",
    "@rollup/plugin-alias": "^5.1.0",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^5.0.5",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/node": "^22.0.0",
    "@vitest/coverage-istanbul": "^4.1.4",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.0",
    "jsdom": "^22.1.0",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "rimraf": "^3.0.2",
    "rollup": "^4.59.0",
    "rollup-plugin-dts": "^6.1.1",
    "rollup-plugin-esbuild": "^6.1.1",
    "rollup-plugin-sourcemaps": "^0.6.3",
    "rollup-plugin-visualizer": "^5.12.0",
    "turbo": "^2.9.14",
    "typedoc": "^0.28.0",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-plugin-not-exported": "^0.1.6",
    "typescript": "^5.4.4",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.34.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "license": "MIT"
}
